FROM eclipse-temurin:17-jdk

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-deu wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY gradlew .
COPY gradlew.bat .
COPY gradle/ gradle/
COPY build.gradle settings.gradle ./

RUN chmod +x ./gradlew

# Pre-warm Gradle dependency cache; source is mounted at runtime
RUN ./gradlew dependencies --no-daemon -q || true

EXPOSE 8080

# --no-watch-fs: the single-use daemon discards its VFS at build end, so watching
# buys nothing here, and inotify over the bind-mounted /app/src fails with EINTR.
CMD ["./gradlew", "bootRun", "--no-daemon", "--no-watch-fs"]
