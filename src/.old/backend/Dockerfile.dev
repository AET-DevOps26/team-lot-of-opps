FROM eclipse-temurin:17-jdk-alpine

WORKDIR /app

COPY gradlew .
COPY gradlew.bat .
COPY gradle/ gradle/
COPY build.gradle settings.gradle ./

RUN chmod +x ./gradlew

# Pre-warm Gradle dependency cache; source is mounted at runtime
RUN ./gradlew dependencies --no-daemon -q || true

EXPOSE 8080

CMD ["./gradlew", "bootRun", "--no-daemon"]
