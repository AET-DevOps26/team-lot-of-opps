# =============================================================================
#  Environment template for team-lot-of-opps
# -----------------------------------------------------------------------------
#  Copy to `.env` (gitignored) and fill in real values for local development:
#      cp .env.example .env
#
#  Every variable the codebase reads is listed below, grouped by service.
#  Lines marked  # [secret]  hold sensitive values and map 1:1 to the GitHub
#  Secrets used by the CI/CD workflows (.github/workflows/*). Everything else
#  is plain config with the in-container default already filled in.
# =============================================================================


# =============================================================================
#  LLM  (shared by invoice-service, suggestions-service, llm-chat)
# =============================================================================
# Prod uses the LOGOS endpoint; local dev can point at LMStudio / Ollama.
LLM_URL=http://host.docker.internal:1234
LLM_MODEL=google/gemma-4-e2b
LLM_API_KEY=EMPTY                                  # [secret] -> GH secret LLM_API_KEY


# =============================================================================
#  Database  (single Postgres instance, three logical schemas)
# =============================================================================
POSTGRES_USER=appuser
DB_PASSWORD=changeme                                # [secret] -> GH secret DB_PASSWORD

# In-container datasource URLs (override only if you change the topology).
# Spring services read SPRING_DATASOURCE_URL; llm-chat reads DATABASE_URL.
# Schema routing is baked into these URLs — do not remove the ?currentSchema param.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/taxforward?currentSchema=invoice
DATABASE_URL=postgresql://appuser:changeme@db:5432/taxforward        # [secret] embeds DB pw


# =============================================================================
#  invoice-service
# =============================================================================
# S3-compatible document store (SeaweedFS locally; endpoint is set by
# docker-compose to http://seaweedfs:8333 — point it at AWS S3 to migrate).
STORAGE_S3_BUCKET=invoices
STORAGE_S3_ACCESS_KEY=devkey
STORAGE_S3_SECRET_KEY=devsecret                     # [secret] -> GH secret STORAGE_S3_SECRET_KEY
STORAGE_S3_REGION=us-east-1
UPLOAD_MAX_SIZE_BYTES=10485760
LLM_CHAT_GRPC_URL=llm-chat:50051


# =============================================================================
#  suggestions-service + export-service
# =============================================================================
INVOICE_SERVICE_GRPC_URL=invoice-service:9090
SUGGESTIONS_INVOICE_LIMIT=5


# =============================================================================
#  auth-service (Firebase)
# =============================================================================
# Defaults run against the local Firebase Auth Emulator (the `firebase-auth`
# compose service) — no real project or service account needed.
#
# To use PRODUCTION Firebase instead: set a real FIREBASE_PROJECT_ID, leave
# FIREBASE_AUTH_EMULATOR_HOST empty, and mount a service-account JSON into the
# auth-service container at GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=demo-taxforward
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth:9099
# GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json   # prod only
# Local dev only: set DEV_AUTH=true to skip Firebase token verification entirely.
# NEVER enable in production.
DEV_AUTH=false


# =============================================================================
#  Client (Vite — baked into the bundle at BUILD time, not runtime)
# =============================================================================
VITE_API_BASE_URL=
VITE_API_TARGET=http://traefik:80
# Emulator defaults — the values below are placeholders the emulator accepts as-is.
# For production Firebase, set VITE_USE_FIREBASE_EMULATOR=false and fill in real
# values from your Firebase project settings (each also a GH secret of the same name).
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099     # browser -> emulator (host port)
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-taxforward.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=$FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=demo-taxforward.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo


# =============================================================================
#  Grafana
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme


# =============================================================================
#  Prod image coordinates  (used by CI/Helm deploys; overridden per-deploy with sha tags)
# =============================================================================
REGISTRY=ghcr.io/aet-devops26/team-lot-of-opps
IMAGE_TAG=latest


# =============================================================================
#  AET cluster deploy  (infra/aet-deploy.sh)
# =============================================================================
# Rancher project the auto-created namespaces are pinned into. Mirrors the GitHub
# repo variable AET_PROJECT_ID used by the deploy workflows. Find yours with:
#   kubectl get ns <existing-ns> -o jsonpath='{.metadata.annotations.field\.cattle\.io/projectId}'
AET_PROJECT_ID=c-f49m7:p-rgm54


# =============================================================================
#  Dev-only toggles  (leave as-is for prod)
# =============================================================================
VITE_DEV_AUTO_LOGIN=false
