{
  "title": "TaxForward",
  "description": "HTTP metrics, JVM memory, and logs for all TaxForward microservices",
  "uid": "taxforward-main",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Request Rate (Spring Boot services)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (job, uri) (rate(http_server_requests_seconds_count{job=~\"invoice-service|suggestions-service\"}[5m]))",
          "legendFormat": "{{job}} {{uri}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Error Rate (4xx + 5xx)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (job, status) (rate(http_server_requests_seconds_count{job=~\"invoice-service|suggestions-service\", status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{job}} {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum by (job, status) (rate(http_request_duration_seconds_count{job=~\"llm-chat|auth-service\", status=~\"4xx|5xx\"}[5m]))",
          "legendFormat": "{{job}} {{status}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "red", "mode": "fixed" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "JVM Heap Memory",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\", job=~\"invoice-service|suggestions-service\"}",
          "legendFormat": "{{job}} heap used",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\", job=~\"invoice-service|suggestions-service\"}",
          "legendFormat": "{{job}} heap max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Request Rate (FastAPI services)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (job, handler) (rate(http_request_duration_seconds_count{job=~\"llm-chat|auth-service\"}[5m]))",
          "legendFormat": "{{job}} {{handler}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Build Version",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "build_info{service=~\"llm-chat|auth-service\"}",
          "legendFormat": "{{service}} v{{version}}",
          "refId": "A"
        },
        {
          "expr": "kube_pod_labels{label_app_kubernetes_io_name=~\"invoice-service|suggestions-service\"}",
          "legendFormat": "{{label_app_kubernetes_io_name}} {{label_app_kubernetes_io_version}}",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Application Logs",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{namespace=\"taxforward\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": []
}
